<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Somente consulta dos pacotes de MLOG e motor de scanner; nenhum acesso a internet. -->
    <queries>
        <package android:name="com.targetsistemas.target_mlog2" />
        <package android:name="com.hikrobotics.pdaservice" />
    </queries>
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="MLOG Scanner Bridge"
        android:theme="@style/BridgeThemeLight"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Acessibilidade opcional, so MLOG. Autorizacao sempre pelo Android. -->
        <service
            android:name=".MlogFocusAccessibilityService"
            android:label="MLOG Bridge - foco inteligente"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/focus_accessibility" />
        </service>
    </application>
</manifest>
